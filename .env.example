# .env.example
# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored — NEVER commit real keys. This template is safe to commit.

# ---- LLM providers ----
# Used by the strategy-pattern LLM layer in pipelines/strategy/.
OPENAI_API_KEY=sk-...your-openai-key...
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key...
OPENROUTER_API_KEY=sk-or-...your-openrouter-key...

# ---- AWS Bedrock (second model: Claude Haiku 4.5) ----
# No API key needed — uses ~/.aws/credentials (IAM user with AmazonBedrockFullAccess).
# Only set these if you want to override the defaults.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ---- MCP search server (read by every pipeline via pipelines/mcp_config.py) ----
# Leave all three blank to use the local mirror: `uv run python -m server.main` on
# http://127.0.0.1:8000/mcp with search_fastapi_knowledge_sources (reproduces published runs).
#
# To run against a Kapa hosted MCP server instead (docs.kapa.ai/retrieval/hosted-mcp-server):
#   MCP_SERVER_URL=https://<subdomain>.mcp.kapa.ai
#   MCP_SERVER_AUTH_TOKEN=<your Kapa API key>       # sent as "Authorization: Bearer <key>"
#   MCP_SEARCH_TOOL=search_<product>_knowledge_sources
MCP_SERVER_URL=
MCP_SERVER_AUTH_TOKEN=
MCP_SEARCH_TOOL=

# ---- Model selection (optional convenience overrides) ----
# The specific model IDs used as the "frontier" and "free" models under test, and the
# cheap model used for claim decomposition. Pin these so runs are reproducible.
FRONTIER_MODEL=
FREE_MODEL=
DECOMPOSITION_MODEL=

# ---- Misc ----
# Where to cache LLM/NLI outputs (gitignored). Helps with re-runs and flaky free models.
CACHE_DIR=.cache
